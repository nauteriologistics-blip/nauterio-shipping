{
  "name": "nauterio-logistics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:web": "pnpm --filter @nauterio/web dev",
    "dev:admin": "pnpm --filter @nauterio/admin dev",
    "dev:api": "pnpm --filter @nauterio/api start:dev",
    "dev:worker": "pnpm --filter @nauterio/worker start:dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nauterio/database generate",
    "db:migrate": "pnpm --filter @nauterio/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @nauterio/database migrate:deploy",
    "db:push:test": "pnpm --filter @nauterio/database exec prisma db push",
    "release:check": "node scripts/release-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "acceptance:production": "node scripts/acceptance-production.mjs",
    "pilot:daily-report": "node scripts/pilot-daily-report.mjs",
    "smoke:load": "node scripts/load-smoke.mjs",
    "db:seed": "pnpm --filter @nauterio/database seed"
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
