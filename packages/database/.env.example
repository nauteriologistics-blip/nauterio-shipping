# Local development default - matches `createdb nauterio_dev` on a local
# PostgreSQL 18 instance. Never commit a real .env file (see root .gitignore).
DATABASE_URL="postgresql://codelord01@localhost:5432/nauterio_dev?schema=public"

# Optional: max connections this process's pool will hold (see src/index.ts).
DATABASE_POOL_MAX=10
