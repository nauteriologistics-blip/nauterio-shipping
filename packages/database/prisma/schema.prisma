// ---------------------------------------------------------------------------
// Audit (append-only - see companion migration for enforcing trigger)
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  // SEC-011/ADR 0002: was `SetNull`, which made a `DELETE FROM users` for any
  // audited user issue an implicit UPDATE on this append-only table -
  // rejected by the trigger with a confusing error, aborting the whole
  // delete. `Restrict` makes the real constraint explicit (a user with audit
  // history cannot be deleted, full stop) instead of failing by accident.
  // Erasure is handled by pseudonymising the User row, never by deleting it.
  actorUser      User?    @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  correlationId  String   @map("correlation_id")
  ipAddress      String?  @map("ip_address")
  deviceInfo     String?  @map("device_info")
  reason         String?
  approvalReference String? @map("approval_reference")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Reliable messaging: outbox / inbox (see ADR 0001 section 7.1)
// ---------------------------------------------------------------------------

enum OutboxEventStatus {
  PENDING
  /// Claimed by a relay worker, publish in progress - a row stuck here
  /// past LEASE_TIMEOUT_MS (worker crashed mid-publish) is reclaimed back
  /// to PENDING by the next poll (REL-006).
  PUBLISHING
  PUBLISHED
  /// Exceeded MAX_ATTEMPTS (REL-005) - a human must look at it; the relay
  /// never retries a DEAD_LETTERED row again.
  DEAD_LETTERED
  FAILED
}

/// Written in the same transaction as the business change it describes.
/// A relay process polls PENDING rows and publishes them to SQS.
model OutboxEvent {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType     String            @map("event_type")
  eventVersion  Int               @default(1) @map("event_version")
  correlationId String            @map("correlation_id")
  payloadJson   Json              @map("payload_json")
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  /// REL-005: backoff schedule - a failed publish pushes this forward
  /// instead of being retried on the very next 2s tick forever.
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  /// REL-006: set when claimed for publishing; lets a crashed worker's
  /// claim be reclaimed after a lease timeout instead of blocking the row
  /// (and therefore the whole FIFO batch) forever.
  claimedAt     DateTime?         @map("claimed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  publishedAt   DateTime?         @map("published_at")

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

/// Records processed provider/queue message IDs so consumers are idempotent
/// (spec section 29.2: "Consumers are idempotent and record processed inbox keys").
model InboxEvent {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  source        String   // queue name or provider name
  messageId     String   @map("message_id")
  processedAt   DateTime @default(now()) @map("processed_at")

  @@unique([source, messageId])
  @@map("inbox_events")
}

// ---------------------------------------------------------------------------
// Partner/business API integration identity
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Idempotency (spec section 26.1: create/financial/booking operations that
// may be retried must be safe to retry with the same Idempotency-Key header)
// ---------------------------------------------------------------------------

enum IdempotencyRecordStatus {
  IN_PROGRESS
  COMPLETED
  /// The handler raised an ambiguous-outcome error (5xx/unknown - may or
  /// may not have committed). Never auto-reclaimed like a client-error
  /// failure is; only cleared by TTL expiry, so a possibly-already-run
  /// operation is never silently retried (SEC-005/DATA-003).
  FAILED
}

/// One row per (scope, userId, key) triple - SEC-005/DATA-001: the
/// principal is part of the uniqueness domain, not an incidental column,
/// so one caller's key can never collide with another caller's. `scope`
/// identifies the controller action (never shared across endpoints, so the
/// same key value on two different endpoints does not collide).
/// `requestHash` detects a key being reused with a different payload,
/// which is a client bug, not a legitimate retry.
model IdempotencyRecord {
  id               String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope            String
  key              String                  @map("idempotency_key")
  requestHash      String                  @map("request_hash")
  userId           String                  @map("user_id") @db.Uuid
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           IdempotencyRecordStatus @default(IN_PROGRESS)
  responseStatus   Int?                    @map("response_status")
  responseBodyJson Json?                   @map("response_body_json")
  createdAt        DateTime                @default(now()) @map("created_at")
  completedAt      DateTime?               @map("completed_at")
  expiresAt        DateTime                @map("expires_at")

  @@unique([scope, userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Short-lived single-use registration verification tokens (spec 27.1:
/// "email verification required before sensitive actions"). Only the hash
/// is stored, same as ApiKey.hashedKey - the raw token exists only in the
/// dev-mode verification URL/response, never persisted. Real production
/// email delivery is not wired (no SES identity configured in this
/// environment - REQUIRES_BUSINESS_EVIDENCE); this table's purpose today is
/// the dev/staging stand-in for that delivery step, not a permanent design.
model EmailVerificationToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model AuthSession {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model ApiClient {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  scopes         String[] @default([])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  @@map("api_clients")
}

model ApiKey {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  apiClientId     String    @map("api_client_id") @db.Uuid
  apiClient       ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  hashedKey       String    @unique @map("hashed_key") // never store the raw key
  lastFourChars   String    @map("last_four_chars")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

model WebhookEndpoint {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  apiClientId     String    @map("api_client_id") @db.Uuid
  apiClient       ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  url             String
  hashedSecret    String    @map("hashed_secret")
  eventTypes      String[]  @default([]) @map("event_types")
  active          Boolean   @default(true)
  lastDeliveryAt  DateTime? @map("last_delivery_at")
  lastFailureAt   DateTime? @map("last_failure_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("webhook_endpoints")
}
