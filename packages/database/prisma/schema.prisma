// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

model Notification {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String?             @map("user_id") @db.Uuid
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  templateCode   String              @map("template_code")
  channel        NotificationChannel
  renderedSubject String?            @map("rendered_subject")
  renderedBodyHash String            @map("rendered_body_hash") // hash only, per privacy-by-design; never store raw PII-laden body long-term
  readAt         DateTime?           @map("read_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  deliveryAttempts DeliveryAttempt[]

  // REL-016: composite instead of a single-column index, so the notification
  // centre's `where: {userId}, orderBy: {id: "desc"}` list query is served
  // by one index scan instead of a filter-then-sort.
  @@index([userId, id])
  @@index([userId, readAt, id])
  @@map("notifications")
}

model DeliveryAttempt {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attemptNumber   Int         @map("attempt_number")
  providerMessageId String?   @map("provider_message_id")
  status          String      // QUEUED | SENT | DELIVERED | BOUNCED | FAILED | COMPLAINED
  attemptedAt     DateTime    @default(now()) @map("attempted_at")

  // REL-009: Postgres does not auto-index foreign keys, and this one had no
  // index at all - `include: {deliveryAttempts: true}` on the notification
  // list sequentially scanned this table on every page load.
  @@index([notificationId, attemptedAt])
  @@map("delivery_attempts")
}

