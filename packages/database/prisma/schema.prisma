// Content
// ---------------------------------------------------------------------------

model ContentPage {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug     String @unique
  titleEn  String @map("title_en")
  titleIt  String @map("title_it")
  currentPolicyVersionId String? @unique @map("current_policy_version_id") @db.Uuid
  currentPolicyVersion   PolicyVersion? @relation("ContentPageCurrentPolicyVersion", fields: [currentPolicyVersionId], references: [id], onDelete: SetNull)

  policyVersions PolicyVersion[]

  @@map("content_pages")
}

model PolicyVersion {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  contentPageId String      @map("content_page_id") @db.Uuid
  contentPage   ContentPage @relation(fields: [contentPageId], references: [id], onDelete: Cascade)
  versionNumber Int         @map("version_number")
  bodyEn        String      @map("body_en")
  bodyIt        String      @map("body_it")
  approved      Boolean     @default(false)
  effectiveAt   DateTime?   @map("effective_at")
