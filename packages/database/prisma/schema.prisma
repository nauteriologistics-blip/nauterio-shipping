// Nauterio Logistics - core data model.
// Source of truth: docs/nauterio-complete-specification.md section 25 and Appendices C/D/E.
//
// Conventions applied throughout (spec section 23.2, 25.4, ADR 0001 section 4.2):
// - Primary keys are UUIDv7, generated by PostgreSQL 18's native uuidv7()
//   function (dbgenerated), not application code. UUIDv7 is time-ordered,
//   which keeps B-tree locality good on high-insert tables.
// - Money is always a (AmountMinorUnits BigInt, Currency Char(3)) pair,
//   never a Float/Decimal alone. Non-negativity is enforced by a CHECK
//   constraint added in a companion migration (see migrations/00000000000001_constraints_and_triggers).
// - Append-only tables (AuditEvent, OutboxEvent, InboxEvent, TrackingEvent
//   corrections) get UPDATE/DELETE revoked from the application role plus a
//   raising trigger in the same companion migration - Prisma's schema DSL
//   cannot express triggers/grants, so those live in raw SQL.
// - Records with realistic concurrent-edit risk carry an optimistic `version`
//   column, bumped via a `WHERE version = $expected` guard in application code.
// - All timestamps are stored in UTC; source timezone/offset is captured
//   separately where an external/local event is involved (see TrackingEvent).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

// Connection URL lives in prisma.config.ts (Prisma 7 removed datasource.url
// from schema files - see ADR 0001 section 1.3 for the driver-adapter
// context this is part of).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & organisations
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Application user. Authentication itself lives in Cognito (external system
/// of record for credentials); this table is the Nauterio-side profile and
/// permission anchor (spec section 21.2's source-of-truth split).
model User {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cognitoSub        String     @unique @map("cognito_sub")
  email             String     @unique
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  status            UserStatus @default(PENDING_VERIFICATION)
  fullName          String     @map("full_name")
  phone             String?
  preferredLanguage String     @default("en") @map("preferred_language") // "en" | "it"
  marketingConsent  Boolean    @default(false) @map("marketing_consent")
  staffRole         String?    @map("staff_role") // null for customers; one of contracts/permissions.ts STAFF_ROLES for staff
  staffWarehouseIds String[]   @default([]) @map("staff_warehouse_ids") @db.Uuid
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  // SEC-011/ADR 0002: non-null once this row has been pseudonymised via a
  // GDPR erasure request - the row is never deleted (see AuditEvent.actorUser
  // below for why), so this is what "erased" means for a User.
  erasedAt          DateTime?  @map("erased_at")

  organisationMemberships OrganisationMember[]
  addresses               Address[]
  contacts                Contact[]
  quotes                  Quote[]
  bookings                Booking[]
  shipmentsAsOwner        Shipment[]            @relation("ShipmentOwnerUser")
  documents               Document[]
  documentsReviewed       Document[]            @relation("DocumentReviewedBy")
  supportLinks            SupportLink[]
  notifications           Notification[]
  auditEventsAsActor      AuditEvent[]          @relation("AuditActorUser")
  claims                  Claim[]
  // DATA-009: reverse sides of the FK relations added to close the audit's
  // "31 unconstrained reference columns" finding - grouped here rather
  // than scattered, since none of these need special handling beyond
  // existing (this User row can be referenced by any number of these).
  pickupsAssignedAsDriver   Pickup[]           @relation("PickupAssignedDriver")
  deliveriesAssignedAsDriver Delivery[]        @relation("DeliveryAssignedDriver")
  documentVersionsUploaded  DocumentVersion[]
  packageMovementsScanned  PackageMovement[]   @relation("PackageMovementScannedBy")
  refundsApproved          Refund[]
  claimDecisions           ClaimDecision[]
  rateCardsApproved        RateCard[]
  invoicesAsCustomer       Invoice[]
  idempotencyRecords       IdempotencyRecord[]
  shipmentsCreated         Shipment[]          @relation("ShipmentCreatedByUser")
  shipmentsHeld            Shipment[]          @relation("ShipmentHeldByUser")
  emailVerificationTokens  EmailVerificationToken[]
  authSessions             AuthSession[]
  pilotIssuesReported      PilotIssue[]         @relation("PilotIssueReporter")
  pilotIssuesAssigned      PilotIssue[]         @relation("PilotIssueAssignee")
  supportConversations     SupportConversation[] @relation("SupportConversationCustomer")
  supportConversationsAssigned SupportConversation[] @relation("SupportConversationAssignee")
  supportMessagesAuthored  SupportMessage[]      @relation("SupportMessageAuthor")

  @@index([status])
  @@map("users")
}

enum OrganisationStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  CLOSED
}

/// Verified business account (spec section 24: Organisations module).
model Organisation {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  legalName         String             @map("legal_name")
  tradingName       String?            @map("trading_name")
  vatNumber         String?            @map("vat_number")
  eoriNumber        String?            @map("eori_number")
  status            OrganisationStatus @default(PENDING_APPROVAL)
  creditLimitAmountMinorUnits BigInt?  @map("credit_limit_amount_minor_units")
  creditLimitCurrency        String?  @db.Char(3) @map("credit_limit_currency")
  contractReference String?            @map("contract_reference")
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  members     OrganisationMember[]
  addresses   Address[]
  quotes      Quote[]
  bookings    Booking[]
  shipments   Shipment[]
  invoices    Invoice[]
  apiClients  ApiClient[]

  @@index([status])
  @@map("organisations")
}

enum OrganisationMemberRole {
  ORGANISATION_ADMIN
  ORGANISATION_MEMBER
}

enum OrganisationMemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// User membership within an Organisation, with an independent approval limit
/// (spec Appendix E: "According to limit" entries key off this, not role alone).
model OrganisationMember {
  id                    String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId        String                    @map("organisation_id") @db.Uuid
  organisation          Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  userId                String                    @map("user_id") @db.Uuid
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                  OrganisationMemberRole
  status                OrganisationMemberStatus  @default(INVITED)
  approvalLimitAmountMinorUnits BigInt?            @map("approval_limit_amount_minor_units")
  approvalLimitCurrency         String?            @db.Char(3) @map("approval_limit_currency")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@unique([organisationId, userId])
  @@map("organisation_members")
}

// ---------------------------------------------------------------------------
// Customers, addresses, contacts
// ---------------------------------------------------------------------------

/// Versioned, provider-validated address (spec: Address entity). Shipments
/// snapshot the address text at booking time (see Shipment.originAddressSnapshot)
/// so historical shipments never change when an address book entry is edited.
model Address {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId     String?   @map("organisation_id") @db.Uuid
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  line1              String
  line2              String?
  city               String
  region             String?
  postalCode         String    @map("postal_code")
  countryCode        String    @db.Char(2) @map("country_code")
  providerValidated  Boolean   @default(false) @map("provider_validated")
  providerResultJson Json?     @map("provider_result_json")
  customerConfirmed  Boolean   @default(false) @map("customer_confirmed")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([organisationId])
  @@map("addresses")
}

enum ContactRole {
  SENDER
  RECEIVER
}

/// Sender/receiver contact for a specific booking or shipment - deliberately
/// separate from Address so a shipment can snapshot "who" independently of
/// the reusable address book (spec: Contact entity).
model Contact {
  id        String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      ContactRole
  fullName  String      @map("full_name")
  phone     String
  email     String?
  companyName String?   @map("company_name")
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Service catalogue, rating, quotes
// ---------------------------------------------------------------------------

enum ServiceId {
  AIR_EXPRESS
  AIR_ECONOMY
  OCEAN_FREIGHT
}

/// Operational service definition (spec: Service entity). Kept intentionally
/// thin at launch (3 services) but modelled as a table, not an enum-only
/// concept, because eligibility/route coverage varies per service over time.
model Service {
  id            ServiceId @id
  name          String
  transitLabel  String    @map("transit_label")
  description   String
  active        Boolean   @default(true)

  routes    Route[]
  rateCards RateCard[]
  shipments Shipment[]
  quotes    Quote[]
  manifests Manifest[]

  @@map("services")
}

/// Origin/destination coverage for a service (spec: Route entity). Launch
/// scope is Italy -> USA only; modelled generally so route expansion doesn't
/// require a schema change.
model Route {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId         ServiceId @map("service_id")
  service           Service   @relation(fields: [serviceId], references: [id])
  originCountry     String    @db.Char(2) @map("origin_country")
  destinationCountry String   @db.Char(2) @map("destination_country")
  activeFrom        DateTime  @map("active_from")
  activeTo          DateTime? @map("active_to")

  @@map("routes")
}

/// Versioned pricing rule set (spec: RateCard/RateRule). REQUIRES_BUSINESS_EVIDENCE:
/// no real rate card exists yet - see CLAUDE.md "do not invent rate cards".
/// The `approved` flag must be true before QuotesModule may use a card for
/// anything other than the flagged-indicative estimate the current frontend
/// already displays.
model RateCard {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId     ServiceId @map("service_id")
  service       Service   @relation(fields: [serviceId], references: [id])
  version       Int
  currency      String    @db.Char(3)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  approved      Boolean   @default(false)
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedBy    User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")

  rules RateRule[]

  @@index([serviceId, approved])
  @@map("rate_cards")
}

/// A single calculation rule within a RateCard (flat fee + per-kg component,
/// minimum charge, weight break). Kept generic so real business rate
/// structures can be loaded without a schema change.
model RateRule {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  rateCardId            String   @map("rate_card_id") @db.Uuid
  rateCard              RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  minWeightKg           Float    @map("min_weight_kg")
  maxWeightKg           Float?   @map("max_weight_kg")
  flatFeeAmountMinorUnits BigInt @map("flat_fee_amount_minor_units")
  perKgAmountMinorUnits   BigInt @map("per_kg_amount_minor_units")
  minimumChargeAmountMinorUnits BigInt @map("minimum_charge_amount_minor_units")

  @@map("rate_rules")
}

enum QuoteStatus {
  DRAFT
  ACCEPTED
  EXPIRED
  REJECTED
}

/// Input snapshot + calculated result for a rating request (spec: Quote/QuoteLine).
/// Accepted quotes snapshot every input and rule so historical totals never
/// change when rate cards change later (spec section 15.1).
model Quote {
  id                    String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String?     @map("user_id") @db.Uuid
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisationId        String?     @map("organisation_id") @db.Uuid
  organisation          Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  serviceId             ServiceId   @map("service_id")
  service               Service     @relation(fields: [serviceId], references: [id])
  status                QuoteStatus @default(DRAFT)
  inputSnapshotJson      Json        @map("input_snapshot_json")
  actualWeightKg        Float       @map("actual_weight_kg")
  volumetricWeightKg    Float       @map("volumetric_weight_kg")
  chargeableWeightKg    Float       @map("chargeable_weight_kg")
  isIndicative          Boolean     @default(true) @map("is_indicative")
  totalAmountMinorUnits BigInt      @map("total_amount_minor_units")
  currency              String      @db.Char(3)
  expiresAt             DateTime    @map("expires_at")
  createdAt             DateTime    @default(now()) @map("created_at")

  lines    QuoteLine[]
  booking  Booking?
  shipments Shipment[]
  invoices  Invoice[]

  @@index([userId])
  @@index([organisationId])
  // REL-015: supports the retention sweep's
  // `status = 'DRAFT' AND expires_at < now()` predicate.
  @@index([status, expiresAt])
  @@map("quotes")
}

/// Individual calculated line item within a quote (base freight, customs
/// filing fee, pickup fee, insurance) - kept as rows, not JSON, so invoices
/// can reference specific lines later.
model QuoteLine {
  id                  String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  quoteId             String @map("quote_id") @db.Uuid
  quote               Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label               String
  amountMinorUnits    BigInt @map("amount_minor_units")
  currency            String @db.Char(3)
  sortOrder           Int    @default(0) @map("sort_order")

  @@map("quote_lines")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

enum BookingStep {
  PACKAGE_DETAILS
  ADDRESSES
  SERVICE
  REVIEW
  CONFIRMED
}

enum ShipmentRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  AWAITING_PAYMENT
  PAID
  REJECTED
  CONVERTED
  CANCELLED
}

/// Draft flow state before conversion to a real Shipment (spec: Booking/Draft
/// entity). Lets a customer leave and resume a booking without losing progress.
model Booking {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisationId String?     @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  quoteId        String?     @unique @map("quote_id") @db.Uuid
  quote          Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  currentStep    BookingStep @default(PACKAGE_DETAILS) @map("current_step")
  requestStatus  ShipmentRequestStatus @default(DRAFT) @map("request_status")
  decisionReason String?     @map("decision_reason")
  submittedAt    DateTime?   @map("submitted_at")
  reviewedAt     DateTime?   @map("reviewed_at")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  draftDataJson  Json        @map("draft_data_json")
  convertedShipmentId String? @unique @map("converted_shipment_id") @db.Uuid
  convertedShipment   Shipment? @relation(fields: [convertedShipmentId], references: [id], onDelete: SetNull)
  invoice         Invoice?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([requestStatus, id])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Shipments, packages, customs items
// ---------------------------------------------------------------------------

enum ShipmentLifecycleStatus {
  DRAFT
  ACTIVE
  ACTION_REQUIRED
  DELIVERED
  CANCELLED
  ARCHIVED
}

/// Master business movement (spec: Shipment entity, field groups per section
/// 25.2: identity, parties, service/route, physical, customs, timing,
/// lifecycle, financial, control - all represented below under those headings).
model Shipment {
  // Identity
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  trackingNumber      String    @unique @map("tracking_number")
  customerReference   String?   @map("customer_reference")
  organisationId      String?   @map("organisation_id") @db.Uuid
  organisation        Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  ownerUser           User?     @relation("ShipmentOwnerUser", fields: [ownerUserId], references: [id], onDelete: Restrict)

  // Parties (snapshotted at booking time - never edited after activation,
  // only corrected via a new version, per spec's append-only tracking rule)
  senderNameSnapshot     String  @map("sender_name_snapshot")
  senderAddressSnapshot  Json    @map("sender_address_snapshot")
  receiverNameSnapshot   String  @map("receiver_name_snapshot")
  receiverAddressSnapshot Json   @map("receiver_address_snapshot")

  // Service/route
  serviceId  ServiceId @map("service_id")
  service    Service   @relation(fields: [serviceId], references: [id])

  // Physical (aggregate across packages; also see Package rows)
  packageCount          Int   @default(1) @map("package_count")
  totalActualWeightKg   Float @map("total_actual_weight_kg")
  totalVolumetricWeightKg Float @map("total_volumetric_weight_kg")
  totalChargeableWeightKg Float @map("total_chargeable_weight_kg")

  // Customs
  declaredValueAmountMinorUnits BigInt  @map("declared_value_amount_minor_units")
  declaredValueCurrency         String  @db.Char(3) @map("declared_value_currency")
  isDeMinimisEligible            Boolean @default(true) @map("is_de_minimis_eligible")
  // DATA-009: was a second, independently-unconstrained `customs_case_id`
  // column duplicating CustomsCase.shipmentId's own unique column, forming
  // two unrelated unique pointers instead of one real 1:1 relation - the
  // exact "both sides of the shipment<->customs-case link" the audit named.
  // Removed (unused anywhere in application code, confirmed by grep) in
  // favour of the single real relation declared on CustomsCase below, which
  // Prisma infers the reverse side of automatically.
  customsCase                      CustomsCase?

  // Timing (UTC; source timezone captured on TrackingEvent, not here)
  pickupTargetAt      DateTime? @map("pickup_target_at")
  dispatchTargetAt    DateTime? @map("dispatch_target_at")
  estimatedDeliveryFrom DateTime? @map("estimated_delivery_from")
  estimatedDeliveryTo   DateTime? @map("estimated_delivery_to")
  deliveredAt          DateTime? @map("delivered_at")

  // Lifecycle
  lifecycleStatus     ShipmentLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  currentTrackingCode String                  @default("SHIPMENT_CREATED") @map("current_tracking_code")
  actionRequiredReason String?                @map("action_required_reason")

  // Financial
  quoteId          String? @map("quote_id") @db.Uuid
  quote            Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  totalAmountMinorUnits BigInt @map("total_amount_minor_units")
  currency          String  @db.Char(3)
  outstandingAmountMinorUnits BigInt @default(0) @map("outstanding_amount_minor_units")

  // Control
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdByUser   User?    @relation("ShipmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  source          String   @default("web") @map("source") // web | admin | api | import
  version         Int      @default(1)
  legalHold       Boolean  @default(false) @map("legal_hold")
  operationalHold Boolean  @default(false) @map("operational_hold")
  holdReason      String?  @map("hold_reason")
  heldAt          DateTime? @map("held_at")
  heldByUserId    String?  @map("held_by_user_id") @db.Uuid
  heldByUser      User?    @relation("ShipmentHeldByUser", fields: [heldByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  packages       Package[]
  items          ShipmentItem[]
  trackingEvents TrackingEvent[]
  pickups        Pickup[]
  deliveries     Delivery[]
  documents      Document[]
  charges        Charge[]
  invoices       InvoiceLine[]
  claims         Claim[]
  manifestItems  ManifestItem[]
  booking             Booking?
  supportLinks        SupportLink[]
  originalForReturns  Return[]      @relation("ReturnOriginalShipment")
  returnShipmentFor   Return?       @relation("ReturnShipment")
  pilotIssues         PilotIssue[]
  supportConversations SupportConversation[]

  @@index([lifecycleStatus])
  // REL-016: list endpoints filter on organisationId/ownerUserId and sort
  // on id (UUIDv7, time-ordered) - a single-column index can seek the
  // filter but must still sort the whole matching set. These composites
  // serve both in one index scan; the single-column indexes they replace
  // covered no query this schema's callers actually run.
  @@index([organisationId, id])
  @@index([ownerUserId, id])
  @@index([currentTrackingCode])
  @@map("shipments")
}

/// Physical handling unit (spec: Package entity).
model Package {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  packageNumber      String   @unique @map("package_number")
  shipmentId         String   @map("shipment_id") @db.Uuid
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sequenceNumber     Int      @map("sequence_number") // e.g. "2 of 4"
  actualWeightKg     Float    @map("actual_weight_kg")
  lengthCm           Float    @map("length_cm")
  widthCm            Float    @map("width_cm")
  heightCm           Float    @map("height_cm")
  volumetricWeightKg Float    @map("volumetric_weight_kg")
  chargeableWeightKg Float    @map("chargeable_weight_kg")
  condition          String   @default("GOOD") // GOOD | DAMAGED | UNDER_REVIEW
  labelDocumentId    String?  @map("label_document_id") @db.Uuid
  labelDocument      Document? @relation("PackageLabelDocument", fields: [labelDocumentId], references: [id], onDelete: SetNull)
  currentStorageLocationId String? @map("current_storage_location_id") @db.Uuid
  currentStorageLocation   StorageLocation? @relation(fields: [currentStorageLocationId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  movements      PackageMovement[]
  trackingEvents TrackingEvent[]
  manifestItems  ManifestItem[]

  @@index([shipmentId])
  @@map("packages")
}

/// Declared customs commodity line (spec: ShipmentItem entity).
model ShipmentItem {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId         String   @map("shipment_id") @db.Uuid
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  description        String
  hsCode             String?  @map("hs_code")
  quantity            Int
  unitValueAmountMinorUnits BigInt @map("unit_value_amount_minor_units")
  currency            String  @db.Char(3)
  countryOfOrigin     String  @db.Char(2) @map("country_of_origin")

  @@index([shipmentId])
  @@map("shipment_items")
}

// ---------------------------------------------------------------------------
// Tracking
// ---------------------------------------------------------------------------

enum TrackingEventSourceType {
  STAFF
  WAREHOUSE_SCAN
  DRIVER
  CARRIER_API
  PARTNER_WEBHOOK
  SYSTEM_AUTOMATION
}

enum TrackingEventVisibility {
  INTERNAL
  AUTHENTICATED_CUSTOMER
  PUBLIC
  RESTRICTED_PROOF
}

/// Canonical tracking event (spec: TrackingEvent entity, field list section
/// 25.3). `canonicalCode` must be one of contracts/tracking-status.ts's
/// TRACKING_STATUSES - enforced at the application layer since Postgres
/// enums are painful to keep in lockstep with a shared TS package; a CHECK
/// constraint mirroring the enum is added in the companion migration instead.
model TrackingEvent {
  id                    String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId            String                   @map("shipment_id") @db.Uuid
  shipment              Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  packageId             String?                  @map("package_id") @db.Uuid
  package               Package?                 @relation(fields: [packageId], references: [id], onDelete: SetNull)
  canonicalCode         String                   @map("canonical_code")
  publicTitleEn         String                   @map("public_title_en")
  publicTitleIt         String                   @map("public_title_it")
  publicDescriptionEn   String?                  @map("public_description_en")
  publicDescriptionIt   String?                  @map("public_description_it")
  internalDescription   String?                  @map("internal_description")
  sourceType            TrackingEventSourceType  @map("source_type")
  sourceId              String?                  @map("source_id")
  sourceEventId         String?                  @map("source_event_id")
  // DATA-017: was `dedupKey String? @unique` - a nullable-unique column
  // Postgres permits unlimited NULLs on, so it deduplicated only rows a
  // producer chose to populate it for, and protected nothing since no
  // ingestion adapter exists yet to ever set it (confirmed unused anywhere
  // in application code). Replaced with a compound unique on fields that
  // already exist and are NOT NULL where it matters: `sourceEventId` is
  // still optional (STAFF/SYSTEM_AUTOMATION events have no external event
  // to dedupe against - dedup doesn't semantically apply to those), but for
  // the case this finding is actually about - the same CARRIER_API/
  // PARTNER_WEBHOOK event delivered twice - a real adapter populating
  // sourceEventId gets real, enforced, NOT-NULL-backed deduplication rather
  // than an opt-in column nothing ever opted into.
  eventTime              DateTime                @map("event_time")
  sourceTimezone         String?                 @map("source_timezone")
  receivedTime            DateTime               @default(now()) @map("received_time")
  locationJson            Json?                  @map("location_json")
  visibility               TrackingEventVisibility @default(AUTHENTICATED_CUSTOMER)
  evidenceDocumentId       String?                @map("evidence_document_id") @db.Uuid
  evidenceDocument          Document?             @relation("TrackingEventEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  correctionOfId           String?                @map("correction_of_id") @db.Uuid
  correctionOf              TrackingEvent?        @relation("TrackingEventCorrection", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections               TrackingEvent[]       @relation("TrackingEventCorrection")
  actorUserId               String?               @map("actor_user_id") @db.Uuid
  reason                    String?
  notificationState          String               @default("NOT_ELIGIBLE") @map("notification_state") // NOT_ELIGIBLE | ELIGIBLE | QUEUED | SENT | SUPPRESSED
  createdAt                  DateTime              @default(now()) @map("created_at")
  externalMappings           ExternalTrackingEvent[]

  @@index([shipmentId, eventTime])
  @@index([canonicalCode])
  // DATA-017: real deduplication for externally-sourced events - see the
  // comment on the (now-removed) dedupKey field above. NULLs in
  // sourceEventId still don't collide (Postgres unique-index semantics),
  // which is correct here: a NULL sourceEventId means "not externally
  // sourced," and those rows aren't supposed to dedupe against each other.
  @@unique([shipmentId, sourceType, sourceEventId])
  @@map("tracking_events")
}

/// Raw provider payload kept for audit/debugging, mapped separately onto a
/// real TrackingEvent (spec section 21.2: "raw provider payload retained
/// securely; mapped public/operational event stored in PostgreSQL").
model ExternalTrackingEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider       String
  providerEventId String  @map("provider_event_id")
  rawPayloadJson  Json    @map("raw_payload_json")
  mappedTrackingEventId String? @map("mapped_tracking_event_id") @db.Uuid
  mappedTrackingEvent   TrackingEvent? @relation(fields: [mappedTrackingEventId], references: [id], onDelete: SetNull)
  receivedAt      DateTime @default(now()) @map("received_at")

  @@unique([provider, providerEventId])
  @@map("external_tracking_events")
}

// ---------------------------------------------------------------------------
// Pickup and delivery
// ---------------------------------------------------------------------------

enum PickupStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  FAILED
  CANCELLED
}

model Pickup {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId      String       @map("shipment_id") @db.Uuid
  shipment        Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  windowStart     DateTime     @map("window_start")
  windowEnd       DateTime     @map("window_end")
  status          PickupStatus @default(REQUESTED)
  assignedDriverUserId String? @map("assigned_driver_user_id") @db.Uuid
  assignedDriverUser   User?   @relation("PickupAssignedDriver", fields: [assignedDriverUserId], references: [id], onDelete: SetNull)
  attemptCount     Int         @default(0) @map("attempt_count")
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document? @relation("PickupEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([shipmentId])
  @@map("pickups")
}

enum DeliveryStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  ATTEMPTED
  DELIVERED
  HELD_FOR_COLLECTION
  FAILED
}

model Delivery {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId           String         @map("shipment_id") @db.Uuid
  shipment             Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  windowStart          DateTime?      @map("window_start")
  windowEnd            DateTime?      @map("window_end")
  status               DeliveryStatus @default(SCHEDULED)
  assignedDriverUserId String?        @map("assigned_driver_user_id") @db.Uuid
  assignedDriverUser   User?          @relation("DeliveryAssignedDriver", fields: [assignedDriverUserId], references: [id], onDelete: SetNull)
  attemptCount         Int            @default(0) @map("attempt_count")
  signatureDocumentId  String?        @map("signature_document_id") @db.Uuid
  signatureDocument    Document?      @relation("DeliverySignatureDocument", fields: [signatureDocumentId], references: [id], onDelete: SetNull)
  proofPhotoDocumentId String?        @map("proof_photo_document_id") @db.Uuid
  proofPhotoDocument   Document?      @relation("DeliveryProofPhotoDocument", fields: [proofPhotoDocumentId], references: [id], onDelete: SetNull)
  recipientName        String?        @map("recipient_name")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([shipmentId])
  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// Warehouse
// ---------------------------------------------------------------------------

model Warehouse {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name     String
  countryCode String @db.Char(2) @map("country_code")
  city     String
  active   Boolean  @default(true)

  storageLocations StorageLocation[]
  manifests        Manifest[]

  @@map("warehouses")
}

/// Hierarchical zone/shelf/bin within a warehouse (spec: StorageLocation entity).
model StorageLocation {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  code        String   // e.g. "A-04-12"
  parentId    String?  @map("parent_id") @db.Uuid
  parent      StorageLocation? @relation("StorageLocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    StorageLocation[] @relation("StorageLocationHierarchy")

  packages  Package[]
  movementsFrom PackageMovement[] @relation("PackageMovementFromLocation")
  movementsTo   PackageMovement[] @relation("PackageMovementToLocation")

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

/// Scan-confirmed custody/storage movement (spec: PackageMovement entity) -
/// append-only alongside TrackingEvent; a movement is evidence, not state to edit.
model PackageMovement {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  packageId       String   @map("package_id") @db.Uuid
  package         Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  fromLocationId  String?  @map("from_location_id") @db.Uuid
  fromLocation    StorageLocation? @relation("PackageMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId    String?  @map("to_location_id") @db.Uuid
  toLocation      StorageLocation? @relation("PackageMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  scannedByUserId String?  @map("scanned_by_user_id") @db.Uuid
  scannedByUser   User?    @relation("PackageMovementScannedBy", fields: [scannedByUserId], references: [id], onDelete: SetNull)
  scannedAt       DateTime @default(now()) @map("scanned_at")

  @@index([packageId])
  @@map("package_movements")
}

enum ManifestStatus {
  OPEN
  DISPATCHED
  RECONCILED
}

/// Dispatch batch (spec: Manifest/ManifestItem entities).
model Manifest {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId  String         @map("warehouse_id") @db.Uuid
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  carrierName  String         @map("carrier_name")
  serviceId    ServiceId      @map("service_id")
  service      Service        @relation(fields: [serviceId], references: [id])
  status       ManifestStatus @default(OPEN)
  dispatchedAt DateTime?      @map("dispatched_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  items ManifestItem[]

  @@map("manifests")
}

model ManifestItem {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  manifestId String   @map("manifest_id") @db.Uuid
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  shipmentId String   @map("shipment_id") @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  packageId  String   @map("package_id") @db.Uuid
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@unique([manifestId, packageId])
  @@map("manifest_items")
}

// ---------------------------------------------------------------------------
// Customs
// ---------------------------------------------------------------------------

enum CustomsCaseStatus {
  OPEN
  ACTION_REQUIRED
  UNDER_REVIEW
  CLEARED
  REJECTED
}

/// Import/export case (spec: CustomsCase entity).
model CustomsCase {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId    String            @unique @map("shipment_id") @db.Uuid
  shipment      Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  status        CustomsCaseStatus @default(OPEN)
  actionType    String?           @map("action_type") // e.g. "INVOICE_REQUESTED", "FDA_PRIOR_NOTICE"
  deadlineAt    DateTime?         @map("deadline_at")
  brokerReference String?         @map("broker_reference")
  outcomeNotes   String?          @map("outcome_notes")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("customs_cases")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentReviewStatus {
  PROCESSING
  APPROVED
  REJECTED
  REPLACEMENT_REQUIRED
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  IDENTITY_DOCUMENT
  CUSTOMS_SUPPORTING_EVIDENCE
  PROOF_OF_DELIVERY_PHOTO
  SIGNATURE
  GENERATED_LABEL
  GENERATED_INVOICE
  GENERATED_RECEIPT
  GENERATED_CUSTOMS_REQUEST
  GENERATED_CLAIM_ACKNOWLEDGEMENT
  GENERATED_CREDIT_NOTE
  GENERATED_REFUND_CONFIRMATION
  GENERATED_RETURN_LABEL
  OTHER
}

/// Metadata only - the object itself lives in S3 (spec section 21.2's
/// source-of-truth split: "S3 object; PostgreSQL stores metadata, access
/// and review state"). See ADR 0001 section 8 for the full upload flow.
model Document {
  id               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUserId      String?               @map("owner_user_id") @db.Uuid
  ownerUser        User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  shipmentId       String?               @map("shipment_id") @db.Uuid
  shipment         Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  type             DocumentType
  currentVersionId String?               @unique @map("current_version_id") @db.Uuid
  currentVersion   DocumentVersion?      @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  reviewStatus     DocumentReviewStatus  @default(PROCESSING) @map("review_status")
  reviewReason     String?               @map("review_reason")
  reviewedAt       DateTime?             @map("reviewed_at")
  reviewedByUserId String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedByUser   User?                 @relation("DocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now()) @map("created_at")

  versions DocumentVersion[]
  pickupsAsEvidence          Pickup[]        @relation("PickupEvidenceDocument")
  deliveriesAsSignature      Delivery[]      @relation("DeliverySignatureDocument")
  deliveriesAsProofPhoto     Delivery[]      @relation("DeliveryProofPhotoDocument")
  trackingEventsAsEvidence   TrackingEvent[] @relation("TrackingEventEvidenceDocument")
  claimEvidenceUses          ClaimEvidence[]
  invoicesAttached           Invoice[]
  packagesAsLabel            Package[]       @relation("PackageLabelDocument")

  @@index([shipmentId])
  @@index([reviewStatus, createdAt])
  @@map("documents")
}

/// Immutable version of a document's underlying file (spec: DocumentVersion
/// entity). New uploads/regenerations always create a new version row.
model DocumentVersion {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int      @map("version_number")
  s3ObjectKey       String  @map("s3_object_key")
  s3Bucket          String  @map("s3_bucket")
  fileSizeBytes     Int     @map("file_size_bytes")
  contentType       String  @map("content_type")
  malwareScanResult String  @default("PENDING") @map("malware_scan_result") // PENDING | CLEAN | INFECTED | ERROR
  templateVersion   String? @map("template_version") // for generated documents
  locale            String? // for generated documents
  generatorSourceHash String? @map("generator_source_hash")
  uploadedByUserId   String? @map("uploaded_by_user_id") @db.Uuid
  uploadedByUser     User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  isCurrentVersionFor Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Billing & payments
// ---------------------------------------------------------------------------

enum ChargeType {
  FREIGHT
  CUSTOMS_FILING
  PICKUP
  INSURANCE
  STORAGE
  SURCHARGE
  ADJUSTMENT
}

model Charge {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId        String     @map("shipment_id") @db.Uuid
  shipment          Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  type              ChargeType
  amountMinorUnits  BigInt     @map("amount_minor_units")
  currency          String     @db.Char(3)
  createdAt         DateTime   @default(now()) @map("created_at")

  @@index([shipmentId])
  @@map("charges")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId String?       @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  customerUserId String?       @map("customer_user_id") @db.Uuid
  customerUser   User?         @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  bookingId      String?       @unique @map("booking_id") @db.Uuid
  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quoteId        String?       @map("quote_id") @db.Uuid
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoiceNumber  String        @unique @map("invoice_number")
  status         InvoiceStatus @default(DRAFT)
  totalAmountMinorUnits BigInt @map("total_amount_minor_units")
  currency       String        @db.Char(3)
  issuedAt       DateTime?     @map("issued_at")
  dueAt          DateTime?     @map("due_at")
  documentId     String?       @map("document_id") @db.Uuid
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@index([organisationId])
  @@index([customerUserId, id])
  @@map("invoices")
}

model InvoiceLine {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipmentId       String?  @map("shipment_id") @db.Uuid
  shipment         Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  description      String
  amountMinorUnits BigInt   @map("amount_minor_units")
  currency         String   @db.Char(3)

  @@map("invoice_lines")
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Nauterio's record of a payment. The provider remains authoritative for its
/// own status (spec section 21.2) - this row is the verified event Nauterio
/// received plus the business allocation, never a guess from a browser
/// redirect (CLAUDE.md: "never infer payment success only from a browser redirect").
model Payment {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider          PaymentProvider
  providerPaymentId String          @map("provider_payment_id")
  providerCheckoutUrl String?       @map("provider_checkout_url")
  status            PaymentStatus   @default(PENDING)
  amountMinorUnits  BigInt          @map("amount_minor_units")
  currency          String          @db.Char(3)
  createdAt         DateTime        @default(now()) @map("created_at")
  confirmedAt       DateTime?       @map("confirmed_at")

  events      PaymentEvent[]
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([provider, providerPaymentId])
  @@map("payments")
}

/// Append-only log of verified provider webhook events (spec: PaymentEvent
/// entity) - never mutated, only inserted; Payment.status is derived from
/// the latest event by application logic, not edited directly by a webhook handler.
model PaymentEvent {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // DATA-018: was a bare String with no provider column at all, so the
  // webhook-replay defence (`@@unique([providerEventId])`) was global
  // across every provider - a PayPal event whose id happened to equal a
  // Stripe event id would be rejected as a false replay. `Payment` already
  // gets this right (`@@unique([provider, providerPaymentId])`); mirrored
  // here while the table is still empty, per the audit's own suggestion to
  // do it now rather than after a real webhook handler ships.
  provider          PaymentProvider
  providerEventId   String   @map("provider_event_id")
  eventType         String   @map("event_type")
  signatureVerified Boolean  @map("signature_verified")
  rawPayloadJson    Json     @map("raw_payload_json")
  receivedAt        DateTime @default(now()) @map("received_at")

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model PaymentAllocation {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId        String   @map("invoice_id") @db.Uuid
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountMinorUnits BigInt   @map("amount_minor_units")
  currency         String   @db.Char(3)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

model Refund {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  status            RefundStatus @default(REQUESTED)
  amountMinorUnits  BigInt       @map("amount_minor_units")
  currency          String       @db.Char(3)
  reason            String
  approvedByUserId  String?      @map("approved_by_user_id") @db.Uuid
  approvedByUser    User?        @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)
  providerRefundId  String?      @map("provider_refund_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  processedAt       DateTime?    @map("processed_at")

  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Claims & returns
// ---------------------------------------------------------------------------

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SETTLED
}

model Claim {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId     String      @map("shipment_id") @db.Uuid
  shipment       Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  submittedByUserId String   @map("submitted_by_user_id") @db.Uuid
  submittedByUser User       @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  status         ClaimStatus @default(SUBMITTED)
  reasonCategory String      @map("reason_category") // DAMAGED | LOST | DELAY | OTHER
  description    String
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  evidence  ClaimEvidence[]
  decisions ClaimDecision[]
  returns   Return[]

  @@index([shipmentId])
  @@map("claims")
}

model ClaimEvidence {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("claim_evidence")
}

model ClaimDecision {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  claimId           String   @map("claim_id") @db.Uuid
  claim             Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  decision          String   // APPROVED | REJECTED | PARTIAL
  decidedByUserId   String   @map("decided_by_user_id") @db.Uuid
  decidedByUser     User     @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  compensationAmountMinorUnits BigInt? @map("compensation_amount_minor_units")
  compensationCurrency        String? @db.Char(3) @map("compensation_currency")
  reason            String
  decidedAt         DateTime @default(now()) @map("decided_at")

  @@map("claim_decisions")
}

model Return {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  claimId             String?  @map("claim_id") @db.Uuid
  claim               Claim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  originalShipmentId  String   @map("original_shipment_id") @db.Uuid
  originalShipment    Shipment @relation("ReturnOriginalShipment", fields: [originalShipmentId], references: [id], onDelete: Restrict)
  returnShipmentId    String?  @unique @map("return_shipment_id") @db.Uuid
  returnShipment      Shipment? @relation("ReturnShipment", fields: [returnShipmentId], references: [id], onDelete: SetNull)
  status              String   @default("REQUESTED") // REQUESTED | IN_TRANSIT | COMPLETED
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("returns")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

/// Linkage only - Zendesk is the conversation record (spec section 21.2).
model SupportLink {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shipmentId       String?  @map("shipment_id") @db.Uuid
  shipment         Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  zendeskTicketId  String   @unique @map("zendesk_ticket_id")
  priority         String   @default("NORMAL") // per spec 17.2 ticket priority
  escalated        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("support_links")
}

enum SupportConversationStatus {
  OPEN
  WAITING_FOR_CUSTOMER
  WAITING_FOR_AGENT
  RESOLVED
  CLOSED
}

enum SupportAuthorType {
  CUSTOMER
  STAFF
  BOT
  SYSTEM
}

model SupportConversation {
  id                    String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerUserId        String                    @map("customer_user_id") @db.Uuid
  customerUser          User                      @relation("SupportConversationCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  shipmentId            String?                   @map("shipment_id") @db.Uuid
  shipment              Shipment?                 @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  assignedStaffUserId   String?                   @map("assigned_staff_user_id") @db.Uuid
  assignedStaffUser     User?                     @relation("SupportConversationAssignee", fields: [assignedStaffUserId], references: [id], onDelete: SetNull)
  subject               String
  status                SupportConversationStatus @default(WAITING_FOR_AGENT)
  lastMessageAt         DateTime                  @default(now()) @map("last_message_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  messages              SupportMessage[]

  @@index([customerUserId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@map("support_conversations")
}

model SupportMessage {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId   String              @map("conversation_id") @db.Uuid
  conversation     SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUserId     String?             @map("author_user_id") @db.Uuid
  authorUser       User?               @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorType       SupportAuthorType   @map("author_type")
  body             String
  createdAt        DateTime            @default(now()) @map("created_at")
  readAt           DateTime?           @map("read_at")

  @@index([conversationId, id])
  @@map("support_messages")
}

enum PilotIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PilotIssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model PilotIssue {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title            String
  description      String
  severity         PilotIssueSeverity @default(MEDIUM)
  status           PilotIssueStatus   @default(OPEN)
  shipmentId       String?            @map("shipment_id") @db.Uuid
  shipment         Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  reportedByUserId String             @map("reported_by_user_id") @db.Uuid
  reportedByUser   User               @relation("PilotIssueReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  assignedToUserId String?            @map("assigned_to_user_id") @db.Uuid
  assignedToUser   User?              @relation("PilotIssueAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
